# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# ── Firebase mode ────────────────────────────────────────────────────────────
# Paste your Realtime Database URL here (found in Firebase Console → RTDB).
# Once set, just run:  python overlay.py   (no --firebase flag needed)
FIREBASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com

# ── Local WebSocket mode (alternative to Firebase) ───────────────────────────
# Uncomment to auto-start the local WS server on launch.
# LOCAL_WS=true
# LOCAL_WS_PORT=8765
